{
  "system": {
    "seed": 42,
    "cache_mode": "ram",
    "dataloader_workers": 8,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "ckpt_dir": "checkpoint"
  },
  "training": {
    "epochs": 400,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 0.05,
    "lr_scheduler": "onecycle"
  },
  "evaluation": {
    "monitor": "val_acc",
    "mode": "max",
    "early_stopping": false,
    "patience": 40,
    "min_delta": 0.0001
  },
  "loss": {
    "loss_type": "ce"
  },
  "model": {
    "backbone": "MultimodalSOTANet",
    "fusion_type": "gating",
    "gate_activation": "sigmoid",
    "classes_num": 4,
    "embed_dim": 384,
    "audio_hidden_dims": [
      768,
      512
    ],
    "video_drop_path": 0.1
  },
  "video_features": {
    "image_size": 224,
    "num_frames": 2,
    "num_channels": 6,
    "temporal_mode": "sum"
  },
  "audio_features": {
    "sample_rate": 256000,
    "window_size": 4096,
    "hop_size": 2048,
    "use_tkeo": true,
    "alpha_max": 0.99,
    "beta": 0.8,
    "use_spectral_aug": true,
    "cutout_width": 24,
    "cutout_prob": 0.5,
    "noise_std": 0.02
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "seed": 42,
    "test_sample_per_class": 700,
    "save_results": true,
    "include_video": true,
    "load_video": true,
    "load_audio": true,
    "split_strategy": "random_sample",
    "evaluation_mode": "holdout",
    "num_folds": 5,
    "fold_index": null,
    "cv_val_ratio": 0.2
  }
}